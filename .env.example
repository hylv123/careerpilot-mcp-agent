# 用法：Copy-Item .env.example .env，然后把下面 4 处值换成你自己的。
#
# ⚠️ 这个文件是【模板】，会被 Git 跟踪，也会被 Docker 打进镜像。
#    真实密钥只能写进 .env —— 它在 .gitignore 里，不会被提交。
#

# OpenAI 兼容的对话模型
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-replace-me

# 阿里云百炼 DashScope，用于 Embedding
DASHSCOPE_API_KEY=sk-replace-me
EMBEDDING_MODEL=text-embedding-v3

# 可选：本地运行时路径
# CAREERPILOT_DB_PATH=data/jobs.db
# CAREERPILOT_OUTPUT_DIR=output
